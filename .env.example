# --- model (D-008/D-009) ---
MODEL_PROFILE=claude-sonnet-api   # any id in agent/models.py REGISTRY; overrides selection
# LLM_PROVIDER=anthropic          # legacy shortcut: anthropic | bedrock | hf
# DATA_RESIDENCY=                 # vendor_api | customer_vpc | self_hosted  (drives select_model)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # inference PROFILE id (us.*), not bare model id
BEDROCK_GUARDRAIL_ID=             # optional, L3 guard
BEDROCK_GUARDRAIL_VERSION=DRAFT
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_ENDPOINT_URL=                  # set after deploy/hf_endpoint.py; else serverless inference for HF_MODEL_ID
HUGGINGFACEHUB_API_TOKEN=
# --- retrieval / data (D-010/D-011) ---
TENANT=demo
MAX_SENSITIVITY=internal          # public | internal | confidential | restricted
EMBED_PROVIDER=none               # none | openai
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# --- guards (D-005/D-012) ---
GUARD_PII=regex                   # regex | presidio
GUARD_INJECTION=regex             # regex | promptguard | lakera
INJECTION_THRESHOLD=0.5
GROUNDING_MIN=0.0                 # 1.0 = reject any ungrounded citation; 0.0 = cap confidence instead
LAKERA_API_KEY=
# --- tracing (D-006/D-013) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fde-agent
# --- evals (D-014) ---
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=fde-agent
EXPERIMENT=baseline
# --- budgets (D-001/D-007) ---
MAX_STEPS=12
MAX_TOOL_CALLS=8
MAX_COST_USD=0.50
